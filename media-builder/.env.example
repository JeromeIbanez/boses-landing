# All keys optional — the pipeline runs end-to-end with offline fallbacks.

# Real image generation (otherwise: offline SVG placeholders)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# LLM shot planning via Claude Agent SDK (otherwise: deterministic planner)
ANTHROPIC_API_KEY=

# Local TTS via Piper — https://github.com/rhasspy/piper
# pip install piper-tts (or brew install piper-tts), then download a voice
# from https://huggingface.co/rhasspy/piper-voices into ./voices, e.g.:
#   en/en_US/ryan/medium/en_US-ryan-medium.onnx (+ .onnx.json alongside it)
PIPER_BIN=piper
PIPER_VOICE=voices/en_US-ryan-medium.onnx

# macOS `say` voice override (used when Piper isn't configured on a Mac)
SAY_VOICE=

# Force providers instead of auto-picking:
# MEDIA_BUILDER_IMAGES=openai|placeholder
# MEDIA_BUILDER_TTS=piper|say|silence
# MEDIA_BUILDER_PLANNER=claude|deterministic
# MEDIA_BUILDER_HIDE_TAGS=1   # hide the on-screen RECONSTRUCTION review tag

# Point Remotion at a specific Chromium binary (rarely needed on a Mac)
# REMOTION_BROWSER_EXECUTABLE=
